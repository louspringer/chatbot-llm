# Ontology: docval:DocumentationValidationOntology
# Implements: validation:DocumentationValidation
# Requirement: REQ-DOC-001 Documentation Validation
# Guidance: guidance:ModelFirstPrinciple#documentation
# Description: SHACL shapes and validation rules for Teams bot documentation
# Cluster: :DeploymentCluster

@prefix : <./chatbot#> .
@prefix docval: <./documentation_validation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix doc: <./documentation#> .
@prefix meta: <./meta#> .
@prefix metameta: <./metameta#> .
@prefix problem: <./problem#> .
@prefix solution: <./solution#> .
@prefix conversation: <./conversation#> .
@prefix guidance: <./guidance#> .
@prefix chatbot: <./chatbot#> .

# Ontology metadata
docval:DocumentationValidationOntology a owl:Ontology ;
    rdfs:label "Documentation Validation Ontology" ;
    rdfs:comment "SHACL shapes and validation rules for Teams bot documentation" ;
    owl:versionInfo "0.1.0" ;
    owl:imports doc:, chatbot:ChatbotLLMOntology ;
    :belongsToCluster chatbot:DeploymentCluster .

# Class Definitions
docval:Documentation a owl:Class ;
    rdfs:label "Documentation" ;
    rdfs:comment "A documentation resource" ;
    owl:versionInfo "0.1.0" .

docval:DocumentationSection a owl:Class ;
    rdfs:label "Documentation Section" ;
    rdfs:comment "A section within documentation" ;
    owl:versionInfo "0.1.0" .

docval:ValidationProcess a owl:Class ;
    rdfs:label "Validation Process" ;
    rdfs:comment "A process for validating documentation" ;
    owl:versionInfo "0.1.0" .

docval:ValidationStep a owl:Class ;
    rdfs:label "Validation Step" ;
    rdfs:comment "A step in the validation process" ;
    owl:versionInfo "0.1.0" .

docval:ValidationRule a owl:Class ;
    rdfs:label "Validation Rule" ;
    rdfs:comment "A rule for validating documentation" ;
    owl:versionInfo "0.1.0" .

# Property Definitions
docval:hasExample a owl:DatatypeProperty ;
    rdfs:label "Has Example" ;
    rdfs:comment "Links to an example in the documentation" ;
    rdfs:domain docval:Documentation ;
    rdfs:range xsd:string .

docval:hasSubsection a owl:ObjectProperty ;
    rdfs:label "Has Subsection" ;
    rdfs:comment "Links to a subsection of documentation" ;
    rdfs:domain docval:DocumentationSection ;
    rdfs:range docval:DocumentationSection .

docval:hasValidationStep a owl:ObjectProperty ;
    rdfs:label "Has Validation Step" ;
    rdfs:comment "Links to a validation step" ;
    rdfs:domain docval:ValidationProcess ;
    rdfs:range docval:ValidationStep .

docval:hasValidationRule a owl:ObjectProperty ;
    rdfs:label "Has Validation Rule" ;
    rdfs:comment "Links to a validation rule" ;
    rdfs:domain docval:ValidationProcess ;
    rdfs:range docval:ValidationRule .

docval:hasErrorMessage a owl:DatatypeProperty ;
    rdfs:label "Has Error Message" ;
    rdfs:comment "Error message for validation failure" ;
    rdfs:domain docval:ValidationRule ;
    rdfs:range xsd:string .

docval:hasReference a owl:DatatypeProperty ;
    rdfs:label "Has Reference" ;
    rdfs:comment "Links to external reference" ;
    rdfs:domain docval:Documentation ;
    rdfs:range xsd:string .

docval:hasInternalReference a owl:DatatypeProperty ;
    rdfs:label "Has Internal Reference" ;
    rdfs:comment "Links to internal reference" ;
    rdfs:domain docval:Documentation ;
    rdfs:range xsd:string .

docval:hasBestPractices a owl:DatatypeProperty ;
    rdfs:label "Has Best Practices" ;
    rdfs:comment "Best practices for implementation" ;
    rdfs:domain docval:DocumentationSection ;
    rdfs:range xsd:string .

docval:hasSecurityConsiderations a owl:DatatypeProperty ;
    rdfs:label "Has Security Considerations" ;
    rdfs:comment "Security considerations for implementation" ;
    rdfs:domain docval:DocumentationSection ;
    rdfs:range xsd:string .

docval:hasValidationCriteria a owl:DatatypeProperty ;
    rdfs:label "Has Validation Criteria" ;
    rdfs:comment "Criteria for validation" ;
    rdfs:domain docval:DocumentationSection ;
    rdfs:range xsd:string .

docval:hasSensitiveDataHandling a owl:DatatypeProperty ;
    rdfs:label "Has Sensitive Data Handling" ;
    rdfs:comment "Guidelines for handling sensitive data" ;
    rdfs:domain docval:DocumentationSection ;
    rdfs:range xsd:string .

# Instance Definitions
docval:setupSection a docval:DocumentationSection ;
    rdfs:label "Setup Documentation" ;
    docval:hasSubsection docval:installationSection ;
    docval:hasBestPractices "Follow security best practices during installation" ;
    docval:hasSecurityConsiderations "Secure credential management" ;
    docval:hasValidationCriteria "All setup steps must be verified" .

docval:installationSection a docval:DocumentationSection ;
    rdfs:label "Installation Guide" ;
    docval:hasExample """```bash
npm install @microsoft/botbuilder
```""" ;
    docval:hasBestPractices "Use package version pinning" ;
    docval:hasSecurityConsiderations "Verify package integrity" .

docval:basicValidationProcess a docval:ValidationProcess ;
    rdfs:label "Basic Validation Process" ;
    docval:hasValidationStep docval:syntaxCheck, docval:securityCheck ;
    docval:hasValidationRule docval:exampleRule, docval:securityRule .

docval:syntaxCheck a docval:ValidationStep ;
    rdfs:label "Syntax Check" ;
    docval:hasExample "Check code block syntax" .

docval:securityCheck a docval:ValidationStep ;
    rdfs:label "Security Check" ;
    docval:hasExample "Verify security guidelines" .

docval:exampleRule a docval:ValidationRule ;
    rdfs:label "Example Rule" ;
    docval:hasErrorMessage "Example must include code block" ;
    docval:hasExample "Code block with language specified" .

docval:securityRule a docval:ValidationRule ;
    rdfs:label "Security Rule" ;
    docval:hasErrorMessage "Security considerations must be documented" ;
    docval:hasExample "Document security measures" .

# Documentation Validation Rules
docval:DocumentationShape a sh:NodeShape ;
    sh:targetClass doc:Documentation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Documentation must have a label."
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Documentation must have a description."
    ] .

# Validation Process Rules
docval:ValidationProcessShape a sh:NodeShape ;
    sh:targetClass docval:ValidationProcess ;
    sh:property [
        sh:path docval:hasValidationStep ;
        sh:minCount 1 ;
        sh:node docval:ValidationStep ;
        sh:message "Validation process must have at least one step."
    ] ;
    sh:property [
        sh:path docval:hasValidationRule ;
        sh:minCount 1 ;
        sh:node docval:ValidationRule ;
        sh:message "Validation process must have at least one rule."
    ] .

# Validation Step Rules
docval:ValidationStepShape a sh:NodeShape ;
    sh:targetClass docval:ValidationStep ;
    sh:property [
        sh:path docval:hasExample ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Validation step must include an example."
    ] .

# Documentation Section Rules
docval:DocumentationSectionShape a sh:NodeShape ;
    sh:targetClass docval:DocumentationSection ;
    sh:property [
        sh:path docval:hasSubsection ;
        sh:node docval:DocumentationSection ;
        sh:message "Subsections must be valid documentation sections."
    ] ;
    sh:property [
        sh:path docval:hasExample ;
        sh:datatype xsd:string ;
        sh:message "Examples must be strings."
    ] .

# Validation Rule Documentation
docval:ValidationRuleShape a sh:NodeShape ;
    sh:targetClass docval:ValidationRule ;
    sh:property [
        sh:path docval:hasErrorMessage ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Validation rule must have an error message."
    ] ;
    sh:property [
        sh:path docval:hasExample ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Validation rule must include an example."
    ] .

# Enhanced Example Format Rules
docval:ExampleFormatShape a sh:NodeShape ;
    sh:targetClass docval:Documentation ;
    sh:property [
        sh:path docval:hasExample ;
        sh:pattern """^(
            (```(turtle|python|json|yaml|typescript|javascript|http|bash|powershell)\\n[\\s\\S]*?\\n```)|
            (```\\n[\\s\\S]*?\\n```)|
            ([\\s\\S]*))$""" ;
        sh:message "Code examples must specify a valid language (turtle, python, json, yaml, typescript, javascript, http, bash, powershell) or be plain text."
    ] ;
    sh:property [
        sh:path docval:hasExample ;
        sh:pattern "^(?!.*`[^`]*$).*$" ;  # Ensure backticks are properly closed
        sh:message "Code block backticks must be properly closed."
    ] ;
    sh:property [
        sh:path docval:hasExample ;
        sh:maxLength 2000 ;
        sh:message "Code examples should not exceed 2000 characters."
    ] .

# Enhanced Cross-Reference Rules
docval:CrossReferenceShape a sh:NodeShape ;
    sh:targetClass docval:Documentation ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            CONSTRUCT {
                ?this docval:validationWarning "Referenced components should exist in deployment ontology."
            }
            WHERE {
                ?this docval:hasExample ?example .
                FILTER CONTAINS(?example, "docval:TeamsBotFunction")
                FILTER NOT EXISTS { deployment:TeamsBotFunction a ?type }
            }
        """
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            CONSTRUCT {
                ?this docval:validationWarning "Referenced bot components should exist in meta ontology."
            }
            WHERE {
                ?this docval:hasExample ?example .
                FILTER (CONTAINS(?example, "meta:BotComponent") ||
                       CONTAINS(?example, "meta:Handler") ||
                       CONTAINS(?example, "meta:Activity") ||
                       CONTAINS(?example, "meta:Context"))
                FILTER NOT EXISTS {
                    ?component a meta:BotComponent
                }
            }
        """
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            CONSTRUCT {
                ?this docval:validationWarning "Referenced solution components should exist in solution ontology."
            }
            WHERE {
                ?this docval:hasExample ?example .
                FILTER (CONTAINS(?example, "solution:TeamsBot") ||
                       CONTAINS(?example, "solution:BotAdapter") ||
                       CONTAINS(?example, "solution:ErrorHandler"))
                FILTER NOT EXISTS {
                    ?component a solution:TeamsBot
                }
            }
        """
    ] ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            CONSTRUCT {
                ?this docval:validationWarning "Referenced conversation components should exist in conversation ontology."
            }
            WHERE {
                ?this docval:hasExample ?example .
                FILTER (CONTAINS(?example, "conversation:Message") ||
                       CONTAINS(?example, "conversation:Response") ||
                       CONTAINS(?example, "conversation:hasText") ||
                       CONTAINS(?example, "conversation:hasType"))
                FILTER NOT EXISTS {
                    ?component a conversation:Message
                }
            }
        """
    ] .

# Enhanced Documentation Completeness Rules
docval:DocumentationCompletenessShape a sh:NodeShape ;
    sh:targetClass docval:DocumentationSection ;
    sh:property [
        sh:path docval:hasExample ;
        sh:minCount 1 ;
        sh:message "Each documentation section must have at least one example."
    ] ;
    sh:property [
        sh:path docval:hasSubsection ;
        sh:minCount 1 ;
        sh:message "Each major documentation section should have subsections."
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:minLength 20 ;
        sh:message "Documentation sections should have meaningful descriptions (at least 20 characters)."
    ] ;
    sh:property [
        sh:path docval:hasBestPractices ;
        sh:minCount 1 ;
        sh:message "Each major section should include best practices."
    ] ;
    sh:property [
        sh:path docval:hasSecurityConsiderations ;
        sh:minCount 1 ;
        sh:message "Documentation must include security considerations where applicable."
    ] ;
    sh:property [
        sh:path docval:hasValidationCriteria ;
        sh:minCount 1 ;
        sh:message "Documentation must specify validation criteria for implementations."
    ] .

# Enhanced Documentation Link Validation
docval:DocumentationLinkShape a sh:NodeShape ;
    sh:targetClass docval:Documentation ;
    sh:property [
        sh:path docval:hasReference ;
        sh:pattern "^(https?://(?:www\\.)?[a-zA-Z0-9-]+(?:\\.[a-zA-Z]{2,})+(?:/[^\\s]*)?|#[\\w-]+|\\.{0,2}/[^\\s]+)$" ;
        sh:message "Documentation links must be valid URLs (http/https), anchors (#section), or relative paths."
    ] ;
    sh:property [
        sh:path docval:hasInternalReference ;
        sh:pattern "^#[a-z][a-zA-Z0-9_-]*$" ;
        sh:message "Internal references must start with # followed by valid identifier characters."
    ] .

# Enhanced Security Documentation Rules
docval:SecurityDocumentationShape a sh:NodeShape ;
    sh:targetClass docval:DocumentationSection ;
    sh:property [
        sh:path docval:hasSecurityConsiderations ;
        sh:property [
            sh:path docval:hasSensitiveDataHandling ;
            sh:minCount 1 ;
            sh:pattern "(?i).*(encryption|masking|tokenization|data protection).*" ;
            sh:message "Must document sensitive data handling practices including encryption, masking, or tokenization."
        ] ;
        sh:property [
            sh:path docval:hasAuthenticationRequirements ;
            sh:minCount 1 ;
            sh:pattern "(?i).*(oauth|jwt|token|certificate|authentication).*" ;
            sh:message "Must specify authentication requirements including protocol and token types."
        ] ;
        sh:property [
            sh:path docval:hasAuthorizationControls ;
            sh:minCount 1 ;
            sh:pattern "(?i).*(rbac|permissions|roles|access control).*" ;
            sh:message "Must document authorization controls including roles and permissions."
        ] ;
        sh:property [
            sh:path docval:hasSecurityHeaders ;
            sh:minCount 1 ;
            sh:pattern "(?i).*(content-security-policy|x-frame-options|strict-transport-security).*" ;
            sh:message "Must document required security headers including CSP, HSTS, etc."
        ]
    ] .

# Best Practices Documentation Rules
docval:BestPracticesShape a sh:NodeShape ;
    sh:targetClass docval:DocumentationSection ;
    sh:property [
        sh:path docval:hasBestPractices ;
        sh:property [
            sh:path docval:hasImplementationGuidelines ;
            sh:minCount 1 ;
            sh:message "Must include implementation guidelines."
        ] ;
        sh:property [
            sh:path docval:hasErrorHandlingPractices ;
            sh:minCount 1 ;
            sh:message "Must document error handling practices."
        ] ;
        sh:property [
            sh:path docval:hasPerformanceConsiderations ;
            sh:minCount 1 ;
            sh:message "Must include performance considerations."
        ] ;
        sh:property [
            sh:path docval:hasScalabilityGuidelines ;
            sh:minCount 1 ;
            sh:message "Must document scalability guidelines."
        ]
    ] .

# Enhanced API Documentation Rules
docval:APIDocumentationShape a sh:NodeShape ;
    sh:targetClass docval:DocumentationSection ;
    sh:property [
        sh:path docval:hasAPIDocumentation ;
        sh:property [
            sh:path docval:hasEndpointDescription ;
            sh:minCount 1 ;
            sh:pattern "(?i)^(GET|POST|PUT|DELETE|PATCH)\\s+/[\\w\\-/{}]*\\s+" ;
            sh:message "Must document API endpoints with HTTP method and path."
        ] ;
        sh:property [
            sh:path docval:hasRequestFormat ;
            sh:minCount 1 ;
            sh:pattern "(?i).*(application/json|multipart/form-data|application/x-www-form-urlencoded).*" ;
            sh:message "Must specify request format with content type."
        ] ;
        sh:property [
            sh:path docval:hasResponseFormat ;
            sh:minCount 1 ;
            sh:pattern "(?i).*(2[0-9]{2}|4[0-9]{2}|5[0-9]{2}).*" ;
            sh:message "Must specify response format with status codes."
        ]
    ] .

# Enhanced Testing Documentation Rules
docval:TestingDocumentationShape a sh:NodeShape ;
    sh:targetClass docval:DocumentationSection ;
    sh:property [
        sh:path docval:hasTestingGuidelines ;
        sh:property [
            sh:path docval:hasUnitTestRequirements ;
            sh:minCount 1 ;
            sh:pattern "(?i).*(assert|expect|should|test case).*" ;
            sh:message "Must specify unit testing requirements with assertion methods."
        ] ;
        sh:property [
            sh:path docval:hasIntegrationTestGuidelines ;
            sh:minCount 1 ;
            sh:pattern "(?i).*(integration|end-to-end|e2e|system test).*" ;
            sh:message "Must include integration testing guidelines with test types."
        ] ;
        sh:property [
            sh:path docval:hasTestCoverage ;
            sh:minCount 1 ;
            sh:pattern "^([1-9][0-9]|100)%$" ;
            sh:message "Must specify required test coverage percentage (1-100%)."
        ]
    ] .

# Enhanced Version Tracking Rules
docval:VersionTrackingShape a sh:NodeShape ;
    sh:targetClass owl:Ontology ;
    sh:property [
        sh:path owl:versionInfo ;
        sh:minCount 1 ;
        sh:pattern "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$" ;
        sh:message "Ontology version must follow semantic versioning (MAJOR.MINOR.PATCH[-PRERELEASE][+BUILD])."
    ] .

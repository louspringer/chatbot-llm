@prefix : <./chatbot#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix meta: <./meta#> .
@prefix problem: <./problem#> .
@prefix solution: <./solution#> .
@prefix conversation: <./conversation#> .
@prefix guidance: <./guidance#> .
@prefix metameta: <./metameta#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix chatbot: <./chatbot#> .

# Ontology Definition
guidance:TeamsBotGuidanceOntology rdf:type owl:Ontology ;
    dc:title "Teams Bot Guidance Ontology" ;
    dc:version "1.0" ;
    dct:created "2024-02-05"^^xsd:date ;
    dct:publisher "Teams Bot Project" ;
    dct:license <http://opensource.org/licenses/MIT> ;
    dct:description "Guidance and validation rules for Teams Bot implementation" ;
    dct:type dct:Dataset ;
    dct:conformsTo <http://www.w3.org/2002/07/owl> ;
    owl:imports meta:, problem:, solution:, conversation:, chatbot:ChatbotLLMOntology ;
    chatbot:belongsToCluster chatbot:DeploymentCluster ;
    owl:versionInfo "1.0" .

# Core Framework Classes
guidance:Interpretation rdf:type owl:Class ;
    rdfs:label "Interpretation" ;
    rdfs:comment "Guidance on how to interpret an ontology element" ;
    rdfs:subClassOf metameta:AbstractionDimension ;
    owl:versionInfo "1.0" .

guidance:Action rdf:type owl:Class ;
    rdfs:label "Action" ;
    rdfs:comment "An action that can be taken based on interpretation" ;
    owl:versionInfo "1.0" .

guidance:DomainAnalogy rdf:type owl:Class ;
    rdfs:label "Domain Analogy" ;
    rdfs:comment "A domain-specific analogy for understanding concepts" ;
    rdfs:subClassOf guidance:Interpretation ;
    owl:versionInfo "1.0" .

# Core Framework Properties
guidance:hasAction rdf:type owl:ObjectProperty ;
    rdfs:label "Has Action" ;
    rdfs:comment "Links an interpretation to its recommended actions" ;
    rdfs:domain guidance:Interpretation ;
    rdfs:range guidance:Action ;
    owl:versionInfo "1.0" .

guidance:analogySource rdf:type owl:DatatypeProperty ;
    rdfs:label "Analogy Source" ;
    rdfs:comment "The source domain of an analogy" ;
    rdfs:domain guidance:DomainAnalogy ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

guidance:analogyTarget rdf:type owl:DatatypeProperty ;
    rdfs:label "Analogy Target" ;
    rdfs:comment "The target domain of an analogy" ;
    rdfs:domain guidance:DomainAnalogy ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

guidance:complexity rdf:type owl:DatatypeProperty ;
    rdfs:label "Complexity" ;
    rdfs:comment "The complexity level of an interpretation" ;
    rdfs:domain guidance:Interpretation ;
    rdfs:range xsd:integer ;
    owl:versionInfo "1.0" .

# Teams Bot Specific Classes
guidance:ErrorHandlingPractice a owl:Class ;
    rdfs:label "Error Handling Practice" ;
    rdfs:comment "Best practices for error handling" ;
    rdfs:subClassOf guidance:Action ;
    owl:versionInfo "1.0" .

guidance:LoggingPractice a owl:Class ;
    rdfs:label "Logging Practice" ;
    rdfs:comment "Best practices for logging" ;
    rdfs:subClassOf guidance:Action ;
    owl:versionInfo "1.0" .

guidance:SecurityPractice a owl:Class ;
    rdfs:label "Security Practice" ;
    rdfs:comment "Best practices for security" ;
    rdfs:subClassOf guidance:Action ;
    owl:versionInfo "1.0" .

guidance:PerformancePractice a owl:Class ;
    rdfs:label "Performance Practice" ;
    rdfs:comment "Best practices for performance" ;
    rdfs:subClassOf guidance:Action ;
    owl:versionInfo "1.0" .

# Additional Properties
guidance:hasExample rdf:type owl:DatatypeProperty ;
    rdfs:label "Has Example" ;
    rdfs:comment "Links a practice to its example code" ;
    rdfs:domain guidance:Action ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

guidance:hasServiceUrl rdf:type owl:DatatypeProperty ;
    rdfs:label "Has Service URL" ;
    rdfs:comment "The service URL for Teams activities" ;
    rdfs:domain meta:Activity ;
    rdfs:range xsd:anyURI ;
    owl:versionInfo "1.0" .

guidance:hasAuthHeader rdf:type owl:DatatypeProperty ;
    rdfs:label "Has Auth Header" ;
    rdfs:comment "The authentication header for requests" ;
    rdfs:domain meta:Activity ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

guidance:requestsPerMinute rdf:type owl:DatatypeProperty ;
    rdfs:label "Requests Per Minute" ;
    rdfs:comment "Number of requests per minute" ;
    rdfs:domain meta:Activity ;
    rdfs:range xsd:integer ;
    owl:versionInfo "1.0" .

guidance:hasType rdf:type owl:DatatypeProperty ;
    rdfs:label "Has Type" ;
    rdfs:comment "The type of Teams activity" ;
    rdfs:domain meta:Activity ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

guidance:hasText rdf:type owl:DatatypeProperty ;
    rdfs:label "Has Text" ;
    rdfs:comment "The text content of a message" ;
    rdfs:domain conversation:Message ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

guidance:hasLocale rdf:type owl:DatatypeProperty ;
    rdfs:label "Has Locale" ;
    rdfs:comment "The locale of a message" ;
    rdfs:domain conversation:Message ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

# Core Validation Rules
guidance:RequestValidation a sh:NodeShape ;
    rdfs:label "Request Validation" ;
    rdfs:comment "Validation rules for HTTP requests" ;
    sh:targetClass meta:Activity ;
    sh:property [
        sh:path conversation:hasType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^(message|typing|contactRelationUpdate|conversationUpdate)$" ;
        sh:message "Activity type must be a valid Teams activity type."
    ] ;
    sh:property [
        sh:path meta:hasServiceUrl ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:message "Service URL is required for Teams activities."
    ] .

guidance:MessageValidation a sh:NodeShape ;
    rdfs:label "Message Validation" ;
    rdfs:comment "Validation rules for messages" ;
    sh:targetClass conversation:Message ;
    sh:property [
        sh:path conversation:hasText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:maxLength 4000 ;
        sh:message "Message text must not exceed 4000 characters."
    ] ;
    sh:property [
        sh:path conversation:hasLocale ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-z]{2}-[A-Z]{2}$" ;
        sh:message "Locale must be in format 'xx-XX' (e.g., 'en-US')."
    ] .

# Authentication Validation
guidance:AuthenticationValidation a sh:NodeShape ;
    rdfs:label "Authentication Validation" ;
    rdfs:comment "Validation rules for authentication" ;
    sh:targetClass meta:Activity ;
    sh:property [
        sh:path meta:hasAuthHeader ;
        sh:minCount 1 ;
        sh:pattern "^Bearer\\s[A-Za-z0-9-_=]+\\.[A-Za-z0-9-_=]+\\.?[A-Za-z0-9-_.+/=]*$" ;
        sh:message "Authentication header must be a valid Bearer token."
    ] .

# Rate Limiting Rules
guidance:RateLimitingShape a sh:NodeShape ;
    rdfs:label "Rate Limiting Rules" ;
    rdfs:comment "Rules for rate limiting" ;
    sh:targetClass meta:Activity ;
    sh:property [
        sh:path meta:requestsPerMinute ;
        sh:maxInclusive 100 ;
        sh:message "Maximum 100 requests per minute per conversation."
    ] .

# Best Practices Instances
guidance:UseTraceActivity a guidance:ErrorHandlingPractice ;
    rdfs:label "Use Trace Activity" ;
    rdfs:comment "Use trace activities for detailed error tracking" ;
    guidance:hasExample """
        await turnContext.sendTraceActivity(
            "Error Processing Message",
            error.stack,
            "https://www.botframework.com/schemas/error",
            "TurnError"
        )
    """ .

guidance:StructuredErrorResponse a guidance:ErrorHandlingPractice ;
    rdfs:label "Structured Error Response" ;
    rdfs:comment "Return structured error responses" ;
    guidance:hasExample """
        {
            "error": {
                "code": "InvalidInput",
                "message": "The input message was invalid",
                "details": ["Field 'text' cannot be empty"]
            }
        }
    """ .

guidance:StructuredLogging a guidance:LoggingPractice ;
    rdfs:label "Structured Logging" ;
    rdfs:comment "Use structured logging with custom dimensions" ;
    guidance:hasExample """
        logger.info("Processing message", extra={
            "activity_id": activity.id,
            "conversation_id": activity.conversation.id,
            "channel_id": activity.channel_id
        })
    """ .

guidance:SensitiveDataLogging a guidance:LoggingPractice ;
    rdfs:label "Sensitive Data Logging" ;
    rdfs:comment "Avoid logging sensitive information" ;
    guidance:hasExample """
        # DO NOT log authorization headers or personal information
        logger.info("Request received", extra={
            "activity_type": activity.type,
            "timestamp": activity.timestamp
        })
    """ .

guidance:TokenValidation a guidance:SecurityPractice ;
    rdfs:label "Token Validation" ;
    rdfs:comment "Validate authentication tokens" ;
    guidance:hasExample """
        await JwtTokenValidation.validateAuthHeader(
            activity.getConnectorClient().credentials.appId,
            authHeader,
            turnContext.activity.serviceUrl
        )
    """ .

guidance:InputSanitization a guidance:SecurityPractice ;
    rdfs:label "Input Sanitization" ;
    rdfs:comment "Sanitize all user input" ;
    guidance:hasExample """
        sanitized_text = html.escape(activity.text)
    """ .

guidance:AsyncOperations a guidance:PerformancePractice ;
    rdfs:label "Async Operations" ;
    rdfs:comment "Use async/await for I/O operations" ;
    guidance:hasExample """
        async def on_message_activity(self, turn_context: TurnContext):
            response = await self.process_message(turn_context)
            await turn_context.send_activity(response)
    """ .

guidance:ConnectionPooling a guidance:PerformancePractice ;
    rdfs:label "Connection Pooling" ;
    rdfs:comment "Use connection pooling for external services" ;
    guidance:hasExample """
        aiohttp.ClientSession(
            connector=aiohttp.TCPConnector(
                limit=100,
                keepalive_timeout=60
            )
        )
    """ .

# Additional Instances
guidance:ErrorRetry a guidance:ErrorHandlingPractice ;
    rdfs:label "Error Retry" ;
    rdfs:comment "Implement retry logic for transient errors" ;
    guidance:hasExample """
        @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=4, max=10))
        async def send_message(self, turn_context: TurnContext, message: str):
            await turn_context.send_activity(message)
    """ .

guidance:CircuitBreaker a guidance:ErrorHandlingPractice ;
    rdfs:label "Circuit Breaker" ;
    rdfs:comment "Implement circuit breaker pattern for external services" ;
    guidance:hasExample """
        @circuit(failure_threshold=5, recovery_timeout=30)
        async def call_external_service(self, request: dict):
            return await self.client.post("/api/endpoint", json=request)
    """ .

guidance:MetricsLogging a guidance:LoggingPractice ;
    rdfs:label "Metrics Logging" ;
    rdfs:comment "Log performance metrics and statistics" ;
    guidance:hasExample """
        logger.info("Request processed", extra={
            "duration_ms": end_time - start_time,
            "memory_usage": process.memory_info().rss,
            "request_count": request_counter.value
        })
    """ .

guidance:AuditLogging a guidance:LoggingPractice ;
    rdfs:label "Audit Logging" ;
    rdfs:comment "Log security-relevant events" ;
    guidance:hasExample """
        logger.info("Security event", extra={
            "event_type": "authentication",
            "user_id": user.id,
            "action": "login",
            "result": "success"
        })
    """ .

guidance:RateLimiting a guidance:SecurityPractice ;
    rdfs:label "Rate Limiting" ;
    rdfs:comment "Implement rate limiting for API endpoints" ;
    guidance:hasExample """
        @rate_limit(requests=100, period=60)
        async def process_message(self, turn_context: TurnContext):
            await self.bot.on_turn(turn_context)
    """ .

guidance:InputValidation a guidance:SecurityPractice ;
    rdfs:label "Input Validation" ;
    rdfs:comment "Validate all input parameters" ;
    guidance:hasExample """
        def validate_message(message: dict):
            assert "text" in message, "Message must contain text"
            assert len(message["text"]) <= 4000, "Message too long"
            assert message["locale"].match(r"^[a-z]{2}-[A-Z]{2}$"), "Invalid locale"
    """ .

guidance:AsyncBatching a guidance:PerformancePractice ;
    rdfs:label "Async Batching" ;
    rdfs:comment "Batch async operations for better performance" ;
    guidance:hasExample """
        async def process_messages(self, messages: List[Message]):
            tasks = [self.process_single_message(msg) for msg in messages]
            return await asyncio.gather(*tasks)
    """ .

guidance:CacheOptimization a guidance:PerformancePractice ;
    rdfs:label "Cache Optimization" ;
    rdfs:comment "Implement caching for frequently accessed data" ;
    guidance:hasExample """
        @cached(ttl=300)  # Cache for 5 minutes
        async def get_user_preferences(self, user_id: str):
            return await self.db.fetch_user_preferences(user_id)
    """ .

# Teams Bot Domain Analogies
guidance:TeamsMessageAnalogy a guidance:DomainAnalogy ;
    rdfs:label "Teams Message Analogy" ;
    rdfs:comment "Analogy for Teams message processing" ;
    guidance:analogySource "Postal Mail System" ;
    guidance:analogyTarget "Teams Message Flow" ;
    guidance:complexity 2 ;
    guidance:hasExample """
        Like a postal system:
        - Message = Letter
        - Channel = Post Office
        - Bot = Mail Sorter
        - Authentication = Postage Stamp
    """ .

guidance:ErrorHandlingAnalogy a guidance:DomainAnalogy ;
    rdfs:label "Error Handling Analogy" ;
    rdfs:comment "Analogy for error handling in Teams bot" ;
    guidance:analogySource "Circuit Breaker System" ;
    guidance:analogyTarget "Bot Error Handling" ;
    guidance:complexity 3 ;
    guidance:hasExample """
        Like an electrical circuit breaker:
        - Error = Power Surge
        - Retry = Reset Switch
        - Circuit Breaker = Automatic Shutdown
        - Recovery = Power Restoration
    """ .

guidance:PerformanceAnalogy a guidance:DomainAnalogy ;
    rdfs:label "Performance Analogy" ;
    rdfs:comment "Analogy for bot performance optimization" ;
    guidance:analogySource "Traffic Management" ;
    guidance:analogyTarget "Bot Performance" ;
    guidance:complexity 3 ;
    guidance:hasExample """
        Like traffic management:
        - Rate Limiting = Traffic Lights
        - Load Balancing = Multiple Lanes
        - Caching = Express Lanes
        - Batching = Convoy System
    """ .

# Additional Validation Rules
guidance:PerformanceValidation a sh:NodeShape ;
    rdfs:label "Performance Validation" ;
    rdfs:comment "Validation rules for performance metrics" ;
    sh:targetClass meta:Activity ;
    sh:property [
        sh:path meta:responseTime ;
        sh:maxInclusive 1000 ;
        sh:message "Response time must not exceed 1000ms."
    ] ,
    [
        sh:path meta:concurrentRequests ;
        sh:maxInclusive 50 ;
        sh:message "Maximum 50 concurrent requests per instance."
    ] .

guidance:SecurityValidation a sh:NodeShape ;
    rdfs:label "Security Validation" ;
    rdfs:comment "Validation rules for security requirements" ;
    sh:targetClass meta:Activity ;
    sh:property [
        sh:path meta:encryptionLevel ;
        sh:minInclusive 128 ;
        sh:message "Minimum encryption level must be 128-bit."
    ] ,
    [
        sh:path meta:tokenExpiry ;
        sh:maxInclusive 3600 ;
        sh:message "Token expiry must not exceed 1 hour."
    ] .

guidance:LoggingValidation a sh:NodeShape ;
    rdfs:label "Logging Validation" ;
    rdfs:comment "Validation rules for logging requirements" ;
    sh:targetClass meta:Activity ;
    sh:property [
        sh:path meta:logLevel ;
        sh:in ("DEBUG" "INFO" "WARNING" "ERROR" "CRITICAL") ;
        sh:message "Log level must be a valid severity level."
    ] ,
    [
        sh:path meta:logRetention ;
        sh:minInclusive 7 ;
        sh:message "Log retention must be at least 7 days."
    ] .


# Ontology: devwf:DevelopmentWorkflowOntology
# Implements: workflow:DevelopmentWorkflow
# Requirement: REQ-DEV-001 Development Workflow
# Guidance: guidance:ModelFirstPrinciple#development
# Description: Models the development workflow, CI/CD processes, and validation stages for the Teams Bot project
# Cluster: :DeploymentCluster

@prefix : <./chatbot#> .
@prefix devwf: <./development_workflow#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix meta: <./meta#> .
@prefix deployment: <./deployment#> .
@prefix doc: <./documentation#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix chatbot: <./chatbot#> .
@prefix metameta: <./metameta#> .
@prefix problem: <./problem#> .
@prefix solution: <./solution#> .
@prefix conversation: <./conversation#> .
@prefix guidance: <./guidance#> .

# Ontology metadata
devwf:DevelopmentWorkflowOntology a owl:Ontology ;
    rdfs:label "Development Workflow Ontology" ;
    rdfs:comment "Ontology for Teams Bot development workflow and CI/CD process" ;
    owl:imports deployment:, meta:, doc:, chatbot:ChatbotLLMOntology ;
    owl:versionInfo "1.0" ;
    dct:created "2024-03-19"^^xsd:date ;
    dct:creator "Teams Bot Development Team" ;
    dct:description "Models the development workflow, CI/CD processes, and validation stages for the Teams Bot project" ;
    chatbot:belongsToCluster chatbot:DeploymentCluster .

# Core Classes
:DevelopmentPhase a owl:Class ;
    rdfs:label "Development Phase" ;
    rdfs:comment "A phase in the development lifecycle" ;
    owl:versionInfo "1.0" .

:WorkflowProcess a owl:Class ;
    rdfs:label "Workflow Process" ;
    rdfs:comment "A process within the development workflow" ;
    owl:versionInfo "1.0" .

:ValidationCheck a owl:Class ;
    rdfs:label "Validation Check" ;
    rdfs:comment "A validation check in the CI/CD pipeline" ;
    owl:versionInfo "1.0" .

:BranchProtection a owl:Class ;
    rdfs:label "Branch Protection" ;
    rdfs:comment "Branch protection rules and requirements" ;
    owl:versionInfo "1.0" .

# Development Phases
:InitialDevelopment a :DevelopmentPhase ;
    rdfs:label "Initial Development" ;
    :hasWorkflowProcess :BasicCIWorkflow ;
    :hasBranchProtection :DevelopBranchProtection ;
    :hasValidationCheck :CodeStyleCheck, :TypeCheck, :OntologyValidation ;
    :isCurrentPhase true ;
    rdfs:comment "Initial development phase with basic checks and flexible rules" .

:BetaPhase a :DevelopmentPhase ;
    rdfs:label "Beta Phase" ;
    :hasWorkflowProcess :EnhancedCIWorkflow ;
    :hasBranchProtection :StrictDevelopProtection ;
    :hasValidationCheck :TestCoverage, :SecurityScan ;
    :isCurrentPhase false ;
    rdfs:comment "Beta phase with enhanced validation and stricter rules" .

:ProductionPhase a :DevelopmentPhase ;
    rdfs:label "Production Phase" ;
    :hasWorkflowProcess :FullCICDPipeline ;
    :hasBranchProtection :MainBranchProtection ;
    :hasValidationCheck :ComprehensiveSecurity, :PerformanceTest ;
    :isCurrentPhase false ;
    rdfs:comment "Production phase with complete pipeline and strict protections" .

# Workflow Processes
:BasicCIWorkflow a :WorkflowProcess ;
    rdfs:label "Basic CI Workflow" ;
    :workflowFile ".github/workflows/dev-validation.yml" ;
    :hasValidationCheck :CodeStyleCheck, :TypeCheck, :OntologyValidation ;
    :continueOnError true ;
    rdfs:comment "Initial CI workflow with non-blocking checks" .

:EnhancedCIWorkflow a :WorkflowProcess ;
    rdfs:label "Enhanced CI Workflow" ;
    :requiresApproval true ;
    :hasValidationCheck :TestCoverage, :SecurityScan ;
    :continueOnError false ;
    rdfs:comment "Enhanced workflow with required checks" .

# Validation Checks
:CodeStyleCheck a :ValidationCheck ;
    rdfs:label "Code Style Check" ;
    :tool "black, flake8" ;
    :isBlocking false ;
    :configuration """
    black --check teams-bot
    flake8 teams-bot --max-line-length=100
    """ .

:TypeCheck a :ValidationCheck ;
    rdfs:label "Type Check" ;
    :tool "mypy" ;
    :isBlocking false ;
    :configuration """
    mypy teams-bot --ignore-missing-imports
    """ .

:OntologyValidation a :ValidationCheck ;
    rdfs:label "Ontology Validation" ;
    :tool "validate_deployment.py" ;
    :isBlocking false ;
    :configuration """
    python teams-bot/validate_deployment.py
    """ .

# Branch Protection Rules
:DevelopBranchProtection a :BranchProtection ;
    rdfs:label "Develop Branch Protection" ;
    :requirePullRequest true ;
    :requiredReviewers 1 ;
    :allowForcePush true ;
    :requireStatusChecks false ;
    rdfs:comment "Initial flexible protection for develop branch" .

:StrictDevelopProtection a :BranchProtection ;
    rdfs:label "Strict Develop Protection" ;
    :requirePullRequest true ;
    :requiredReviewers 1 ;
    :allowForcePush false ;
    :requireStatusChecks true ;
    rdfs:comment "Stricter protection for develop branch in beta phase" .

# Properties
:hasWorkflowProcess a owl:ObjectProperty ;
    rdfs:label "Has Workflow Process" ;
    rdfs:comment "Links a development phase to its workflow processes" ;
    rdfs:domain :DevelopmentPhase ;
    rdfs:range :WorkflowProcess ;
    owl:versionInfo "1.0" .

:hasValidationCheck a owl:ObjectProperty ;
    rdfs:label "Has Validation Check" ;
    rdfs:comment "Links a workflow process or phase to its validation checks" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf (:WorkflowProcess :DevelopmentPhase)
    ] ;
    rdfs:range :ValidationCheck ;
    owl:versionInfo "1.0" .

:hasBranchProtection a owl:ObjectProperty ;
    rdfs:label "Has Branch Protection" ;
    rdfs:comment "Links a development phase to its branch protection rules" ;
    rdfs:domain :DevelopmentPhase ;
    rdfs:range :BranchProtection ;
    owl:versionInfo "1.0" .

:isCurrentPhase a owl:DatatypeProperty ;
    rdfs:label "Is Current Phase" ;
    rdfs:comment "Indicates if this is the current development phase" ;
    rdfs:domain :DevelopmentPhase ;
    rdfs:range xsd:boolean ;
    owl:versionInfo "1.0" .

:isBlocking a owl:DatatypeProperty ;
    rdfs:label "Is Blocking" ;
    rdfs:comment "Indicates if a validation check blocks the workflow" ;
    rdfs:domain :ValidationCheck ;
    rdfs:range xsd:boolean ;
    owl:versionInfo "1.0" .

:workflowFile a owl:DatatypeProperty ;
    rdfs:label "Workflow File" ;
    rdfs:comment "Path to the workflow file" ;
    rdfs:domain :WorkflowProcess ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

:tool a owl:DatatypeProperty ;
    rdfs:label "Tool" ;
    rdfs:comment "The tool used for validation" ;
    rdfs:domain :ValidationCheck ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

:configuration a owl:DatatypeProperty ;
    rdfs:label "Configuration" ;
    rdfs:comment "Configuration for the validation tool" ;
    rdfs:domain :ValidationCheck ;
    rdfs:range xsd:string ;
    owl:versionInfo "1.0" .

:requirePullRequest a owl:DatatypeProperty ;
    rdfs:label "Require Pull Request" ;
    rdfs:comment "Whether pull requests are required" ;
    rdfs:domain :BranchProtection ;
    rdfs:range xsd:boolean ;
    owl:versionInfo "1.0" .

:requiredReviewers a owl:DatatypeProperty ;
    rdfs:label "Required Reviewers" ;
    rdfs:comment "Number of required reviewers" ;
    rdfs:domain :BranchProtection ;
    rdfs:range xsd:integer ;
    owl:versionInfo "1.0" .

:allowForcePush a owl:DatatypeProperty ;
    rdfs:label "Allow Force Push" ;
    rdfs:comment "Whether force push is allowed" ;
    rdfs:domain :BranchProtection ;
    rdfs:range xsd:boolean ;
    owl:versionInfo "1.0" .

:requireStatusChecks a owl:DatatypeProperty ;
    rdfs:label "Require Status Checks" ;
    rdfs:comment "Whether status checks are required" ;
    rdfs:domain :BranchProtection ;
    rdfs:range xsd:boolean ;
    owl:versionInfo "1.0" .

:continueOnError a owl:DatatypeProperty ;
    rdfs:label "Continue On Error" ;
    rdfs:comment "Whether to continue workflow on error" ;
    rdfs:domain :WorkflowProcess ;
    rdfs:range xsd:boolean ;
    owl:versionInfo "1.0" .

:requiresApproval a owl:DatatypeProperty ;
    rdfs:label "Requires Approval" ;
    rdfs:comment "Whether workflow requires approval" ;
    rdfs:domain :WorkflowProcess ;
    rdfs:range xsd:boolean ;
    owl:versionInfo "1.0" .

# SHACL Shapes
:DevelopmentPhaseShape a sh:NodeShape ;
    sh:targetClass :DevelopmentPhase ;
    sh:property [
        sh:path :hasWorkflowProcess ;
        sh:minCount 1 ;
        sh:class :WorkflowProcess ;
        sh:message "Development phase must have at least one workflow process."
    ] ;
    sh:property [
        sh:path :hasBranchProtection ;
        sh:minCount 1 ;
        sh:class :BranchProtection ;
        sh:message "Development phase must have branch protection rules."
    ] .

:WorkflowProcessShape a sh:NodeShape ;
    sh:targetClass :WorkflowProcess ;
    sh:property [
        sh:path :hasValidationCheck ;
        sh:minCount 1 ;
        sh:class :ValidationCheck ;
        sh:message "Workflow process must have at least one validation check."
    ] .

:ValidationCheckShape a sh:NodeShape ;
    sh:targetClass :ValidationCheck ;
    sh:property [
        sh:path :tool ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Validation check must specify a tool."
    ] ,
    [
        sh:path :isBlocking ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Validation check must specify if it is blocking."
    ] .

:BranchProtectionShape a sh:NodeShape ;
    sh:targetClass :BranchProtection ;
    sh:property [
        sh:path :requirePullRequest ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Branch protection must specify if pull requests are required."
    ] ,
    [
        sh:path :requiredReviewers ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "Branch protection must specify number of required reviewers."
    ] .

# Additional Instances
:TestCoverage a :ValidationCheck ;
    rdfs:label "Test Coverage Check" ;
    :tool "pytest-cov" ;
    :isBlocking true ;
    :configuration """
    pytest --cov=teams-bot --cov-report=xml
    """ .

:SecurityScan a :ValidationCheck ;
    rdfs:label "Security Scan" ;
    :tool "bandit" ;
    :isBlocking true ;
    :configuration """
    bandit -r teams-bot -ll
    """ .

:ComprehensiveSecurity a :ValidationCheck ;
    rdfs:label "Comprehensive Security" ;
    :tool "safety, bandit" ;
    :isBlocking true ;
    :configuration """
    safety check
    bandit -r teams-bot -ll
    """ .

:PerformanceTest a :ValidationCheck ;
    rdfs:label "Performance Test" ;
    :tool "locust" ;
    :isBlocking true ;
    :configuration """
    locust -f performance/locustfile.py --headless -u 10 -r 2
    """ .

:FullCICDPipeline a :WorkflowProcess ;
    rdfs:label "Full CI/CD Pipeline" ;
    :workflowFile ".github/workflows/prod-pipeline.yml" ;
    :hasValidationCheck :ComprehensiveSecurity, :PerformanceTest ;
    :continueOnError false ;
    :requiresApproval true ;
    rdfs:comment "Complete pipeline for production deployment" .

:MainBranchProtection a :BranchProtection ;
    rdfs:label "Main Branch Protection" ;
    :requirePullRequest true ;
    :requiredReviewers 2 ;
    :allowForcePush false ;
    :requireStatusChecks true ;
    rdfs:comment "Strict protection for main branch in production" .

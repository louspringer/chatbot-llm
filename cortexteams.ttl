# Ontology: cortexteams:CortexTeamsOntology
# Implements: integration:TeamsIntegration
# Requirement: REQ-INT-001 Teams Integration
# Guidance: guidance:ModelFirstPrinciple#integration
# Description: Defines the integration between Snowflake Cortex and Microsoft Teams
# Cluster: :DeploymentCluster

@prefix : <./chatbot#> .
@prefix cortexteams: <./cortexteams#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix chatbot: <./chatbot#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix meta: <./meta#> .
@prefix metameta: <./metameta#> .
@prefix problem: <./problem#> .
@prefix solution: <./solution#> .
@prefix conversation: <./conversation#> .
@prefix guidance: <./guidance#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Ontology metadata
cortexteams:CortexTeamsOntology a owl:Ontology ;
    rdfs:label "Snowflake Cortex Teams Integration" ;
    rdfs:comment "Ontology for the integration between Snowflake Cortex and Microsoft Teams" ;
    owl:imports chatbot:ChatbotLLMOntology ;
    owl:versionInfo "0.1.0" ;
    chatbot:belongsToCluster chatbot:DeploymentCluster .

# Integration Context and Constraints
:EnterpriseContext a chatbot:Context ;
    rdfs:label "Enterprise Environment" ;
    rdfs:comment "The enterprise environment requiring secure and scalable integration." .

:PrivacyConstraint a chatbot:Constraint ;
    rdfs:label "Data Privacy" ;
    rdfs:comment "Compliance with enterprise data privacy regulations." .

# Core Integration Components
:TeamsBot a chatbot:Integration ;
    rdfs:label "Teams Bot Interface" ;
    rdfs:comment "Bot interface for Microsoft Teams integration" ;
    chatbot:hasRequirement :TeamsAuthentication ;
    chatbot:hasWorkflow :QueryWorkflow, :CheckpointRestartFlow ;
    chatbot:connectsTo :CortexConnector .

:CortexConnector a chatbot:Integration ;
    rdfs:label "Snowflake Cortex Connector" ;
    rdfs:comment "Connector for Snowflake Cortex services" ;
    chatbot:hasRequirement :SnowflakeAuthentication ;
    chatbot:hasWorkflow :DataAccessFlow, :CheckpointRestartFlow .

# Authentication Requirements
:TeamsAuthentication a chatbot:SecurityRequirement ;
    rdfs:label "Teams OAuth Authentication" ;
    rdfs:comment "OAuth 2.0 authentication for Microsoft Teams" .

:SnowflakeAuthentication a chatbot:SecurityRequirement ;
    rdfs:label "Snowflake Key Authentication" ;
    rdfs:comment "Key-based authentication for Snowflake services" .

# Integration Workflows
:QueryWorkflow a chatbot:Workflow ;
    rdfs:label "Query Processing Workflow" ;
    rdfs:comment "Workflow for processing queries from Teams to Cortex" ;
    chatbot:hasStep :UserQuery, :AuthCheck, :CortexQuery, :ResponseFormat .

:DataAccessFlow a chatbot:Workflow ;
    rdfs:label "Data Access Flow" ;
    rdfs:comment "Workflow for secure data access and transformation" ;
    chatbot:hasStep :AccessCheck, :DataFetch, :Transform .

# Workflow Steps
:UserQuery a chatbot:WorkflowStep ;
    rdfs:label "User Query Input" ;
    rdfs:comment "Process user query from Teams interface" .

:AuthCheck a chatbot:WorkflowStep ;
    rdfs:label "Authentication Check" ;
    rdfs:comment "Verify user authentication and permissions" .

:CortexQuery a chatbot:WorkflowStep ;
    rdfs:label "Cortex Query Execution" ;
    rdfs:comment "Execute query against Snowflake Cortex" .

:ResponseFormat a chatbot:WorkflowStep ;
    rdfs:label "Response Formatting" ;
    rdfs:comment "Format Cortex response for Teams display" .

:AccessCheck a chatbot:WorkflowStep ;
    rdfs:label "Access Verification" ;
    rdfs:comment "Verify data access permissions" .

:DataFetch a chatbot:WorkflowStep ;
    rdfs:label "Data Retrieval" ;
    rdfs:comment "Fetch data from Snowflake Cortex" .

:Transform a chatbot:WorkflowStep ;
    rdfs:label "Data Transformation" ;
    rdfs:comment "Transform data for Teams display" .

# Add Checkpoint-Restart Workflow
:CheckpointRestartFlow a chatbot:Workflow ;
    rdfs:label "Checkpoint-Restart Flow" ;
    rdfs:comment "Workflow for saving and restoring conversation state between Teams and Cortex" ;
    chatbot:hasStep :SaveState, :ValidateState, :RestoreContext .

# Checkpoint-Restart Steps
:SaveState a chatbot:WorkflowStep ;
    rdfs:label "Save Conversation State" ;
    rdfs:comment "Serialize and store current conversation context: User identity and permissions; Current query context; Active Cortex session; Temporal markers" .

:ValidateState a chatbot:WorkflowStep ;
    rdfs:label "Validate State" ;
    rdfs:comment "Verify stored state integrity and permissions: Check state freshness; Verify security context; Validate data access rights" .

:RestoreContext a chatbot:WorkflowStep ;
    rdfs:label "Restore Context" ;
    rdfs:comment "Rebuild conversation context from stored state: Rehydrate user context; Restore Cortex session; Resume workflow position" .

:architectureDiagram a :Documentation ;
    rdfs:label "Architecture Diagram" ;
    :path "assets/diagrams/generated/cortex_teams_architecture.svg" .

:deploymentDiagram a :Documentation ;
    rdfs:label "Deployment Diagram" ;
    :path "assets/diagrams/generated/cortex_teams_deployment.svg" .

# Class Definitions
cortexteams:TeamsChannel a owl:Class ;
    rdfs:label "Teams Channel" ;
    rdfs:comment "A Microsoft Teams channel for integration" ;
    owl:versionInfo "0.1.0" .

cortexteams:TeamsMessage a owl:Class ;
    rdfs:label "Teams Message" ;
    rdfs:comment "A message sent to or received from Teams" ;
    owl:versionInfo "0.1.0" .

cortexteams:TeamsUser a owl:Class ;
    rdfs:label "Teams User" ;
    rdfs:comment "A Microsoft Teams user" ;
    owl:versionInfo "0.1.0" .

cortexteams:TeamsBot a owl:Class ;
    rdfs:label "Teams Bot" ;
    rdfs:comment "A bot integrated with Microsoft Teams" ;
    owl:versionInfo "0.1.0" .

# Property Definitions
cortexteams:hasChannelId a owl:DatatypeProperty ;
    rdfs:label "has channel ID" ;
    rdfs:comment "The unique identifier of a Teams channel" ;
    rdfs:domain cortexteams:TeamsChannel ;
    rdfs:range xsd:string .

cortexteams:hasMessageId a owl:DatatypeProperty ;
    rdfs:label "has message ID" ;
    rdfs:comment "The unique identifier of a Teams message" ;
    rdfs:domain cortexteams:TeamsMessage ;
    rdfs:range xsd:string .

cortexteams:hasUserId a owl:DatatypeProperty ;
    rdfs:label "has user ID" ;
    rdfs:comment "The unique identifier of a Teams user" ;
    rdfs:domain cortexteams:TeamsUser ;
    rdfs:range xsd:string .

cortexteams:hasBotId a owl:DatatypeProperty ;
    rdfs:label "has bot ID" ;
    rdfs:comment "The unique identifier of a Teams bot" ;
    rdfs:domain cortexteams:TeamsBot ;
    rdfs:range xsd:string .

cortexteams:hasContent a owl:DatatypeProperty ;
    rdfs:label "has content" ;
    rdfs:comment "The content of a Teams message" ;
    rdfs:domain cortexteams:TeamsMessage ;
    rdfs:range xsd:string .

cortexteams:hasSender a owl:ObjectProperty ;
    rdfs:label "has sender" ;
    rdfs:comment "Links a message to its sender" ;
    rdfs:domain cortexteams:TeamsMessage ;
    rdfs:range cortexteams:TeamsUser .

cortexteams:hasChannel a owl:ObjectProperty ;
    rdfs:label "has channel" ;
    rdfs:comment "Links a message to its channel" ;
    rdfs:domain cortexteams:TeamsMessage ;
    rdfs:range cortexteams:TeamsChannel .

# SHACL Shapes
cortexteams:TeamsChannelShape a sh:NodeShape ;
    sh:targetClass cortexteams:TeamsChannel ;
    sh:property [
        sh:path cortexteams:hasChannelId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

cortexteams:TeamsMessageShape a sh:NodeShape ;
    sh:targetClass cortexteams:TeamsMessage ;
    sh:property [
        sh:path cortexteams:hasMessageId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ,
    [
        sh:path cortexteams:hasContent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ,
    [
        sh:path cortexteams:hasSender ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cortexteams:TeamsUser ;
    ] ,
    [
        sh:path cortexteams:hasChannel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class cortexteams:TeamsChannel ;
    ] .

# Instances
cortexteams:generalChannel a cortexteams:TeamsChannel ;
    rdfs:label "General Channel" ;
    cortexteams:hasChannelId "general-123" .

cortexteams:announcementsChannel a cortexteams:TeamsChannel ;
    rdfs:label "Announcements Channel" ;
    cortexteams:hasChannelId "announcements-456" .

cortexteams:user1 a cortexteams:TeamsUser ;
    rdfs:label "John Doe" ;
    cortexteams:hasUserId "user-123" .

cortexteams:user2 a cortexteams:TeamsUser ;
    rdfs:label "Jane Smith" ;
    cortexteams:hasUserId "user-456" .

cortexteams:chatbot a cortexteams:TeamsBot ;
    rdfs:label "Cortex Assistant" ;
    cortexteams:hasBotId "bot-789" .

cortexteams:message1 a cortexteams:TeamsMessage ;
    cortexteams:hasMessageId "msg-123" ;
    cortexteams:hasContent "Hello, team!" ;
    cortexteams:hasSender cortexteams:user1 ;
    cortexteams:hasChannel cortexteams:generalChannel .

cortexteams:message2 a cortexteams:TeamsMessage ;
    cortexteams:hasMessageId "msg-456" ;
    cortexteams:hasContent "Important announcement" ;
    cortexteams:hasSender cortexteams:user2 ;
    cortexteams:hasChannel cortexteams:announcementsChannel .

# Property Definitions for chatbot: namespace
chatbot:belongsToCluster a owl:ObjectProperty ;
    rdfs:label "Belongs to Cluster" ;
    rdfs:comment "Links an ontology to its deployment cluster" ;
    rdfs:domain owl:Ontology ;
    rdfs:range chatbot:DeploymentCluster ;
    owl:versionInfo "0.1.0" .

chatbot:hasRequirement a owl:ObjectProperty ;
    rdfs:label "Has Requirement" ;
    rdfs:comment "Links a component to its requirements" ;
    rdfs:domain chatbot:Integration ;
    rdfs:range chatbot:SecurityRequirement ;
    owl:versionInfo "0.1.0" .

chatbot:hasWorkflow a owl:ObjectProperty ;
    rdfs:label "Has Workflow" ;
    rdfs:comment "Links a component to its workflows" ;
    rdfs:domain chatbot:Integration ;
    rdfs:range chatbot:Workflow ;
    owl:versionInfo "0.1.0" .

chatbot:connectsTo a owl:ObjectProperty ;
    rdfs:label "Connects To" ;
    rdfs:comment "Links an integration to another integration" ;
    rdfs:domain chatbot:Integration ;
    rdfs:range chatbot:Integration ;
    owl:versionInfo "0.1.0" .

chatbot:hasStep a owl:ObjectProperty ;
    rdfs:label "Has Step" ;
    rdfs:comment "Links a workflow to its steps" ;
    rdfs:domain chatbot:Workflow ;
    rdfs:range chatbot:WorkflowStep ;
    owl:versionInfo "0.1.0" .

# Class Definitions for chatbot: namespace
chatbot:Context a owl:Class ;
    rdfs:label "Context" ;
    rdfs:comment "A context for integration" ;
    owl:versionInfo "0.1.0" .

chatbot:Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A constraint on integration" ;
    owl:versionInfo "0.1.0" .

chatbot:Integration a owl:Class ;
    rdfs:label "Integration" ;
    rdfs:comment "An integration component" ;
    owl:versionInfo "0.1.0" .

chatbot:SecurityRequirement a owl:Class ;
    rdfs:label "Security Requirement" ;
    rdfs:comment "A security requirement for integration" ;
    owl:versionInfo "0.1.0" .

chatbot:Workflow a owl:Class ;
    rdfs:label "Workflow" ;
    rdfs:comment "A workflow in the integration" ;
    owl:versionInfo "0.1.0" .

chatbot:WorkflowStep a owl:Class ;
    rdfs:label "Workflow Step" ;
    rdfs:comment "A step in a workflow" ;
    owl:versionInfo "0.1.0" .

chatbot:DeploymentCluster a owl:Class ;
    rdfs:label "Deployment Cluster" ;
    rdfs:comment "A deployment cluster for integration" ;
    owl:versionInfo "0.1.0" .

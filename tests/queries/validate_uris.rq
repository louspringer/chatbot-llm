# Ontology: test:URIValidation
# Implements: test:ValidationFramework
# Requirement: REQ-TEST-003 URI Validation
# Guidance: guidance:TestingPattern#URIValidation
# Description: SPARQL query to validate URI patterns in ontology files

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Find any URIs that use absolute file paths or user-specific paths
SELECT DISTINCT ?subject ?predicate ?object
WHERE {
  ?subject ?predicate ?object .
  FILTER(isURI(?object))
  # Only match true absolute paths, not relative paths that got converted
  FILTER(REGEX(STR(?object), "^(file:///[A-Za-z]:|/Users/|/home/|/root/|[A-Za-z]:\\\\Users\\\\)"))
}
ORDER BY ?subject ?predicate ?object

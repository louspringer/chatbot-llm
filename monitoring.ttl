# Ontology: chatbot:MonitoringOntology
# Implements: chatbot:MonitoringModel
# Requirement: REQ-MON-001 System monitoring and alerting
# Guidance: guidance:monitoring#SystemMonitoring
# Description: Defines monitoring requirements, KPIs, alerts, and implementation details

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix meta: <./meta#> .
@prefix metameta: <./metameta#> .
@prefix problem: <./problem#> .
@prefix solution: <./solution#> .
@prefix conversation: <./conversation#> .
@prefix guidance: <./guidance#> .
@prefix monitor: <#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Ontology Definition
monitor:MonitoringOntology rdf:type owl:Ontology ;
    rdfs:label "Monitoring Ontology" ;
    rdfs:comment "Ontology for system monitoring and alerting" ;
    owl:versionInfo "1.0.0" .

# Classes
monitor:MonitoringRequirement a owl:Class ;
    rdfs:label "Monitoring Requirement" ;
    rdfs:comment "Defines monitoring requirements for system components and processes" ;
    owl:versionInfo "1.0.0" .

monitor:KPI a owl:Class ;
    rdfs:label "Key Performance Indicator" ;
    rdfs:comment "Defines performance metrics and indicators used to measure system health and performance" ;
    owl:versionInfo "1.0.0" .

monitor:Alert a owl:Class ;
    rdfs:label "Alert" ;
    rdfs:comment "Defines monitoring alerts and notifications for system events and conditions" ;
    owl:versionInfo "1.0.0" .

monitor:Implementation a owl:Class ;
    rdfs:label "Implementation" ;
    rdfs:comment "Specifies monitoring implementation details including tools, configurations, and integrations" ;
    owl:versionInfo "1.0.0" .

# Properties
monitor:hasKPI a owl:ObjectProperty ;
    rdfs:domain monitor:MonitoringRequirement ;
    rdfs:range monitor:KPI .

monitor:hasAlert a owl:ObjectProperty ;
    rdfs:domain monitor:MonitoringRequirement ;
    rdfs:range monitor:Alert .

monitor:hasImplementation a owl:ObjectProperty ;
    rdfs:domain monitor:MonitoringRequirement ;
    rdfs:range monitor:Implementation .

monitor:hasMetric a owl:DatatypeProperty ;
    rdfs:domain monitor:KPI ;
    rdfs:range xsd:string .

# SHACL Validation Rules
monitor:MonitoringRequirementShape a sh:NodeShape ;
    sh:targetClass monitor:MonitoringRequirement ;
    sh:property [
        sh:path monitor:hasKPI ;
        sh:minCount 1 ;
        sh:message "Must have at least one KPI defined"
    ] ;
    sh:property [
        sh:path monitor:hasAlert ;
        sh:minCount 1 ;
        sh:message "Must have at least one alert defined"
    ] ;
    sh:property [
        sh:path monitor:hasImplementation ;
        sh:minCount 1 ;
        sh:message "Must specify implementation details"
    ] .

monitor:KPIShape a sh:NodeShape ;
    sh:targetClass monitor:KPI ;
    sh:property [
        sh:path monitor:hasMetric ;
        sh:minCount 1 ;
        sh:message "Must have at least one metric defined"
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Must have a label"
    ] .

monitor:AlertShape a sh:NodeShape ;
    sh:targetClass monitor:Alert ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Must have a label"
    ] .

# Instances
monitor:SuccessRate a monitor:KPI ;
    rdfs:label "Success Rate" ;
    monitor:hasMetric "RotationSuccess", "RotationDuration" .

monitor:BackupHealth a monitor:KPI ;
    rdfs:label "Backup Health" ;
    monitor:hasMetric "BackupSuccess", "StorageUtilization" .

monitor:SecurityMetrics a monitor:KPI ;
    rdfs:label "Security Metrics" ;
    monitor:hasMetric "PermissionErrors", "FailedAccess" .

monitor:CriticalAlerts a monitor:Alert ;
    rdfs:label "Critical Alerts" .

monitor:WarningAlerts a monitor:Alert ;
    rdfs:label "Warning Alerts" .

monitor:CloudWatchMetrics a monitor:Implementation ;
    rdfs:label "CloudWatch Metrics Implementation" .

# Additional Instances
monitor:InfoAlerts a monitor:Alert ;
    rdfs:label "Info Alerts" .

monitor:PrometheusMetrics a monitor:Implementation ;
    rdfs:label "Prometheus Metrics Implementation" .

monitor:LatencyMetrics a monitor:KPI ;
    rdfs:label "Latency Metrics" ;
    monitor:hasMetric "RequestLatency", "ProcessingTime" .

monitor:ResourceUtilization a monitor:KPI ;
    rdfs:label "Resource Utilization" ;
    monitor:hasMetric "CPUUsage", "MemoryUsage", "DiskUsage" .

monitor:DatabaseMonitoring a monitor:MonitoringRequirement ;
    rdfs:label "Database Monitoring" ;
    monitor:hasKPI monitor:LatencyMetrics ;
    monitor:hasAlert monitor:CriticalAlerts ;
    monitor:hasImplementation monitor:CloudWatchMetrics .

monitor:APIMonitoring a monitor:MonitoringRequirement ;
    rdfs:label "API Monitoring" ;
    monitor:hasKPI monitor:ResourceUtilization ;
    monitor:hasAlert monitor:WarningAlerts ;
    monitor:hasImplementation monitor:PrometheusMetrics .

{
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#fef3eb",
        "activityBar.background": "#fef3eb",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#09b652",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#15202b99",
        "sash.hoverBorder": "#fef3eb",
        "statusBar.background": "#fbd6bb",
        "statusBar.foreground": "#15202b",
        "statusBarItem.hoverBackground": "#f8b98b",
        "statusBarItem.remoteBackground": "#fbd6bb",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#fbd6bb",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#fbd6bb99",
        "titleBar.inactiveForeground": "#15202b99"
    },
    "peacock.color": "#fbd6bb",
    "azureFunctions.deploySubpath": "teams-bot",
    "azureFunctions.scmDoBuildDuringDeployment": true,
    "azureFunctions.pythonVenv": ".venv",
    "azureFunctions.projectLanguage": "Python",
    "azureFunctions.projectRuntime": "~4",
    "debug.internalConsoleOptions": "neverOpen",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    // Python formatting settings
    "python.formatting.provider": "black",
    "python.formatting.blackArgs": [
        "--line-length",
        "88"
    ],
    "editor.formatOnSave": true,
    "editor.rulers": [
        88
    ],
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.fixAll.ruff": "explicit"
    },
    // Disable all linters except Ruff
    "python.linting.enabled": false,
    "python.linting.flake8Enabled": false,
    "python.linting.pylintEnabled": false,
    "python.linting.mypyEnabled": false,
    "python.linting.pylintArgs": [], // Clear any Pylint arguments
    "python.linting.pylintPath": "", // Clear Pylint path
    // Enable Ruff
    "ruff.enable": true,
    "ruff.organizeImports": true,
    "ruff.fixAll": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    }
}

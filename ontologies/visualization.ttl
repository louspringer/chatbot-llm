# Ontology: viz:VisualizationOntology
# Implements: visualization:VisualizationSystem
# Requirement: REQ-VIZ-001 Visualization Generation
# Guidance: guidance:ModelFirstPrinciple#visualization
# Description: Defines visualization types and generation capabilities

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix meta: <./meta#> .
@prefix metameta: <./metameta#> .
@prefix problem: <./problem#> .
@prefix solution: <./solution#> .
@prefix conversation: <./conversation#> .
@prefix guidance: <./guidance#> .
@prefix viz: <#> .

# Classes
viz:Visualizer a owl:Class ;
    rdfs:label "Visualizer" ;
    rdfs:comment "Base class for visualization generators" ;
    owl:versionInfo "1.0.0" .

viz:PlantUMLVisualizer a owl:Class ;
    rdfs:subClassOf viz:Visualizer ;
    rdfs:label "PlantUML Visualizer" ;
    rdfs:comment "Generates PlantUML diagrams" ;
    owl:versionInfo "1.0.0" .

viz:MatplotlibVisualizer a owl:Class ;
    rdfs:subClassOf viz:Visualizer ;
    rdfs:label "Matplotlib Visualizer" ;
    rdfs:comment "Generates Matplotlib-based visualizations" ;
    owl:versionInfo "1.0.0" .

viz:VisualizationEngine a owl:Class ;
    rdfs:label "Visualization Engine" ;
    rdfs:comment "Main engine for handling visualizations" ;
    owl:versionInfo "1.0.0" .

viz:VisualizationType a owl:Class ;
    rdfs:label "Visualization Type" ;
    rdfs:comment "Type of visualization to generate" ;
    owl:versionInfo "1.0.0" .

viz:VisualizationOutput a owl:Class ;
    rdfs:label "Visualization Output" ;
    rdfs:comment "Output from visualization generation" ;
    owl:versionInfo "1.0.0" .

# Properties
viz:hasVisualizer a owl:ObjectProperty ;
    rdfs:label "Has Visualizer" ;
    rdfs:comment "Links an engine to its visualizer" ;
    rdfs:domain viz:VisualizationEngine ;
    rdfs:range viz:Visualizer .

viz:generatesOutput a owl:ObjectProperty ;
    rdfs:label "Generates Output" ;
    rdfs:comment "Links a visualizer to its output" ;
    rdfs:domain viz:Visualizer ;
    rdfs:range viz:VisualizationOutput .

viz:hasType a owl:ObjectProperty ;
    rdfs:label "Has Type" ;
    rdfs:comment "Links output to its visualization type" ;
    rdfs:domain viz:VisualizationOutput ;
    rdfs:range viz:VisualizationType .

viz:hasFormat a owl:DatatypeProperty ;
    rdfs:label "Has Format" ;
    rdfs:comment "Specifies the output format" ;
    rdfs:domain viz:VisualizationOutput ;
    rdfs:range xsd:string .

viz:hasConfiguration a owl:DatatypeProperty ;
    rdfs:label "Has Configuration" ;
    rdfs:comment "Configuration settings for the visualizer" ;
    rdfs:domain viz:Visualizer ;
    rdfs:range xsd:string .

viz:hasTheme a owl:DatatypeProperty ;
    rdfs:label "Has Theme" ;
    rdfs:comment "Visual theme settings" ;
    rdfs:domain viz:Visualizer ;
    rdfs:range xsd:string .

viz:hasResolution a owl:DatatypeProperty ;
    rdfs:label "Has Resolution" ;
    rdfs:comment "Output resolution settings" ;
    rdfs:domain viz:VisualizationOutput ;
    rdfs:range xsd:string .

viz:hasDescription a owl:DatatypeProperty ;
    rdfs:label "Has Description" ;
    rdfs:comment "Detailed description of the visualization" ;
    rdfs:domain viz:VisualizationType ;
    rdfs:range xsd:string .

# Instances
viz:defaultEngine a viz:VisualizationEngine ;
    rdfs:label "Default Engine" ;
    rdfs:comment "Default visualization engine instance" ;
    viz:hasVisualizer viz:defaultPlantUMLVisualizer .

viz:defaultPlantUMLVisualizer a viz:PlantUMLVisualizer ;
    rdfs:label "Default PlantUML Visualizer" ;
    rdfs:comment "Default PlantUML diagram generator" ;
    viz:generatesOutput viz:defaultPlantUMLOutput .

viz:defaultMatplotlibVisualizer a viz:MatplotlibVisualizer ;
    rdfs:label "Default Matplotlib Visualizer" ;
    rdfs:comment "Default Matplotlib plot generator" ;
    viz:generatesOutput viz:defaultMatplotlibOutput .

viz:defaultPlantUMLOutput a viz:VisualizationOutput ;
    rdfs:label "Default PlantUML Output" ;
    rdfs:comment "Default PlantUML diagram output" ;
    viz:hasType viz:PlantUMLType ;
    viz:hasFormat "puml" .

viz:defaultMatplotlibOutput a viz:VisualizationOutput ;
    rdfs:label "Default Matplotlib Output" ;
    rdfs:comment "Default Matplotlib plot output" ;
    viz:hasType viz:MatplotlibType ;
    viz:hasFormat "png" .

viz:PlantUMLType a viz:VisualizationType ;
    rdfs:label "PlantUML" ;
    rdfs:comment "PlantUML diagram type" ;
    viz:hasFormat "puml" .

viz:MatplotlibType a viz:VisualizationType ;
    rdfs:label "Matplotlib" ;
    rdfs:comment "Matplotlib plot type" ;
    viz:hasFormat "png" .

viz:JSONDiagram a viz:VisualizationType ;
    rdfs:label "JSON Diagram" ;
    rdfs:comment "JSON structure visualization" ;
    rdfs:subClassOf viz:PlantUMLType .

viz:PieChart a viz:VisualizationType ;
    rdfs:label "Pie Chart" ;
    rdfs:comment "Circular statistical plot" ;
    rdfs:subClassOf viz:PlantUMLType .

viz:SequenceDiagram a viz:VisualizationType ;
    rdfs:label "Sequence Diagram" ;
    rdfs:comment "Interaction sequence visualization" ;
    rdfs:subClassOf viz:PlantUMLType .

viz:LinePlot a viz:VisualizationType ;
    rdfs:label "Line Plot" ;
    rdfs:comment "Line-based data visualization" ;
    rdfs:subClassOf viz:MatplotlibType .

viz:BarPlot a viz:VisualizationType ;
    rdfs:label "Bar Plot" ;
    rdfs:comment "Bar-based data visualization" ;
    rdfs:subClassOf viz:MatplotlibType .

viz:ScatterPlot a viz:VisualizationType ;
    rdfs:label "Scatter Plot" ;
    rdfs:comment "Point-based data visualization" ;
    rdfs:subClassOf viz:MatplotlibType .

# Additional Instances
viz:backupEngine a viz:VisualizationEngine ;
    rdfs:label "Backup Engine" ;
    rdfs:comment "Backup visualization engine instance" ;
    viz:hasVisualizer viz:backupPlantUMLVisualizer .

viz:backupPlantUMLVisualizer a viz:PlantUMLVisualizer ;
    rdfs:label "Backup PlantUML Visualizer" ;
    rdfs:comment "Backup PlantUML diagram generator" ;
    viz:generatesOutput viz:backupPlantUMLOutput ;
    viz:hasConfiguration "backup-config" ;
    viz:hasTheme "dark" .

viz:backupPlantUMLOutput a viz:VisualizationOutput ;
    rdfs:label "Backup PlantUML Output" ;
    rdfs:comment "Backup PlantUML diagram output" ;
    viz:hasType viz:PlantUMLType ;
    viz:hasFormat "svg" ;
    viz:hasResolution "1920x1080" .

viz:developmentEngine a viz:VisualizationEngine ;
    rdfs:label "Development Engine" ;
    rdfs:comment "Development visualization engine instance" ;
    viz:hasVisualizer viz:devMatplotlibVisualizer .

viz:devMatplotlibVisualizer a viz:MatplotlibVisualizer ;
    rdfs:label "Development Matplotlib Visualizer" ;
    rdfs:comment "Development Matplotlib plot generator" ;
    viz:generatesOutput viz:devMatplotlibOutput ;
    viz:hasConfiguration "dev-config" ;
    viz:hasTheme "light" .

viz:devMatplotlibOutput a viz:VisualizationOutput ;
    rdfs:label "Development Matplotlib Output" ;
    rdfs:comment "Development Matplotlib plot output" ;
    viz:hasType viz:MatplotlibType ;
    viz:hasFormat "pdf" ;
    viz:hasResolution "3840x2160" .

# SHACL Validation
viz:VisualizerShape a sh:NodeShape ;
    sh:targetClass viz:Visualizer ;
    sh:property [
        sh:path viz:generatesOutput ;
        sh:minCount 1 ;
        sh:message "Visualizer must generate at least one output type"
    ] .

viz:VisualizationOutputShape a sh:NodeShape ;
    sh:targetClass viz:VisualizationOutput ;
    sh:property [
        sh:path viz:hasType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Output must have exactly one visualization type"
    ] .
